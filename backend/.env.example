# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ridgetopai
DB_USER=ridgetopai
DB_PASSWORD=your_password_here

# Mandrel MCP Server
MANDREL_URL=https://mandrel.ridgetopai.net/mcp/tools

# Remote Execution (optional)
USE_REMOTE_EXECUTION=false
REMOTE_HOST=localhost
REMOTE_PORT=2222
REMOTE_USER=ridgetop

# Server Port
PORT=3002

# Gemini API for Image Generation
GEMINI_API_KEY=your_gemini_api_key_here

# Image Storage Configuration
IMAGE_STORAGE_PATH=/var/lib/ridgetopai/images
IMAGE_PUBLIC_URL_BASE=https://ridge.ridgetopai.net/images
IMAGE_RETENTION_DAYS=60
